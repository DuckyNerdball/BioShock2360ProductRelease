{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "BioShock 2 (Xbox 360) Recomp",
  "repo": "DuckyNerdball/BioShock2360ProductRelease",
  "inputs": [
    {
      "id": "game",
      "label": "Your own BioShock 2 (Xbox 360) disc image (.iso). Setup extracts it, checks it is the supported build (title ID 54540861, Bioshock2_Xenon.xex SHA-1 b4196d2bd339ff5e80ee1ce9100cb288bac8a13f) and builds single player and the offline multiplayer from it on this PC. It does not need the .iso again afterwards.",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "iso"
          ]
        }
      ],
      "check": {
        "xdvdfs": "Bioshock2_Xenon.xex"
      }
    }
  ],
  "start": {
    "program": [
      "app/out/build/win-amd64-relwithdebinfo/bs2start.exe",
      "bs2start.exe",
      "BioShock2.cmd"
    ],
    "args": [
      "--game_data_root",
      "{install}/game_bs2",
      "--user_data_root",
      "{install}/userdata",
      "--log_file",
      "{install}/bioshock2.log",
      "--gpu_plugin",
      "xenos",
      "--resolve_1011_exp_bias=0",
      "--fetch_1011_exp_adjust_delta=-3",
      "--skip_hdr_1011_resolve_bias=-3",
      "--bioshock_sharp_composite",
      "--resolution_scale=2",
      "--anisotropic_override=5",
      "--present_cas_additional_sharpness=0.7",
      "--bioshock_bloom_scale=1.0",
      "--bioshock_gamma=1.05",
      "--bioshock_exposure_scale=1.0",
      "--present_effect=cas",
      "--swap_post_effect=fxaa",
      "--present_dither=true",
      "--texture_cache_memory_limit_soft=2048",
      "--texture_cache_memory_limit_hard=4096",
      "--texture_cache_memory_limit_render_to_texture=128",
      "--draw_resolution_scaled_texture_offsets=false",
      "--video_mode_refresh_rate=120",
      "--skip_pixel_shaders=32B3EC0C91CA5BCC",
      "--direct_host_resolve=true"
    ]
  },
  "prepare": {
    "program": [
      "Prepare.cmd"
    ],
    "label": "Builds the game from your disc: installs the build tools, extracts your .iso and compiles single player and multiplayer (1-2 hours the first time; asks for administrator approval once)",
    "env": {
      "BS_ISO": "{input:game}"
    },
    "keeps_copy": true,
    "done": [
      "{install}/game_bs2/Bioshock2_Xenon.xex",
      "{install}/app/out/build/win-amd64-relwithdebinfo/bioshock2.exe",
      "{install}/app/out/build/win-amd64-relwithdebinfo/bs2start.exe"
    ],
    "options": [
      {
        "id": "vs",
        "label": "Install Visual Studio 2022 Community (C++ and Clang) if this PC does not have it",
        "note": "Needed to compile the game. Skipped when Visual Studio C++ is already installed.",
        "os": [
          "windows"
        ],
        "license": {
          "name": "Visual Studio 2022 Community",
          "url": "https://visualstudio.microsoft.com/license-terms/vs2022-ga-community/"
        },
        "args": [
          "-AcceptVsLicense"
        ],
        "required": false
      }
    ]
  },
  "saves": [
    "{install}/userdata"
  ],
  "folders": {
    "game": [
      {
        "path": "{install}/game_bs2"
      }
    ],
    "saves": [
      {
        "path": "{install}/userdata"
      }
    ],
    "logs": [
      {
        "path": "{install}"
      }
    ]
  },
  "settings": [
    {
      "id": "resolution",
      "label": "Resolution",
      "in": "args",
      "help": "What the game draws at. 720p is the console's own. 4K needs a fast graphics card.",
      "choices": [
        {
          "label": "1440p",
          "args": []
        },
        {
          "label": "720p",
          "args": [
            "--resolution_scale=1"
          ]
        },
        {
          "label": "4K",
          "args": [
            "--resolution_scale=3"
          ]
        }
      ]
    },
    {
      "id": "sharpening",
      "label": "Sharpening",
      "in": "args",
      "help": "How the picture is fitted to your screen. CAS keeps edges crisp. Off is the softest.",
      "choices": [
        {
          "label": "CAS",
          "args": []
        },
        {
          "label": "FSR",
          "args": [
            "--present_effect=fsr"
          ]
        },
        {
          "label": "Off",
          "args": [
            "--present_effect=bilinear"
          ]
        }
      ]
    },
    {
      "id": "aa",
      "label": "Anti-aliasing",
      "in": "args",
      "help": "Smooths jagged edges after the frame is drawn. Stronger is a little softer.",
      "choices": [
        {
          "label": "FXAA",
          "args": []
        },
        {
          "label": "FXAA, stronger",
          "args": [
            "--swap_post_effect=fxaa_extreme"
          ]
        },
        {
          "label": "Off",
          "args": [
            "--swap_post_effect=none"
          ]
        }
      ]
    },
    {
      "id": "mplook",
      "label": "Multiplayer picture",
      "help": "Multiplayer only. Soft glow keeps a little of the game's bloom around lights and fire. Clean removes it for the sharpest image.",
      "in": "args",
      "choices": [
        {
          "label": "Soft glow",
          "args": []
        },
        {
          "label": "Clean (no glow)",
          "args": [
            "--bs2mplook=clean"
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "saves",
      "label": "Saves",
      "help": "Your saves and profile.",
      "open": "saves"
    },
    {
      "id": "logs",
      "label": "Log",
      "help": "The log of the last run, for bug reports.",
      "open": "logs"
    }
  ],
  "games": [
    {
      "id": "sp",
      "name": "BioShock 2",
      "args": [
        "--bs2mode=sp"
      ]
    },
    {
      "id": "mp",
      "name": "BioShock 2 Multiplayer (offline, vs bots)",
      "args": [
        "--bs2mode=mp"
      ],
      "saves": [
        "{install}/mp/run/userdata",
        "{install}/userdata_mp"
      ]
    }
  ]
}
