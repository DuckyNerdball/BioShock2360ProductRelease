 using namespace rex::system;
 
+// bioshock2mp (2026-11-07): see fake_live_signin in xam_user.cpp. With it on, unknown XLIVEBASE messages log
+// their buffer and SUCCEED (BS2 MP treats a failed 0x58035 during the profile save as "connection to LIVE lost").
+static void DumpLiveBuffer(uint32_t message, uint32_t buffer_ptr, const uint8_t* buffer, uint32_t buffer_length) {
+  std::string hx;
+  for (uint32_t i = 0; buffer && i < 0x40; i += 4) {
+    hx += fmt::format("{}{:08X}", i ? " " : "", rex::memory::load_and_swap<uint32_t>(buffer + i));
+  }
+  REXKRNL_WARN("fake_live: XLIVEBASE msg={:08X} buf={:08X} len={:08X} words: {}", message, buffer_ptr, buffer_length, hx);
+}
+
