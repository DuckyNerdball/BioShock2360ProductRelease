+// bioshock-recomp: per-shader float constant tools, for tuning a composite without a hash-specific code path.
+//   ps_const_log = HASH[,HASH]              log every float constant those pixel shaders read (a few times each)
+//   ps_const_mul = HASH:index:component:factor[,...]   multiply one component (0-3 = x-w) of constant c<index>
+REXCVAR_DEFINE_STRING(ps_const_log, "", "GPU/D3D12", "Pixel shader hashes whose float constants are logged")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+REXCVAR_DEFINE_STRING(ps_const_mul, "", "GPU/D3D12", "HASH:index:component:factor list of pixel shader constant multipliers")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+namespace {
+struct BsPsConstMul { uint64_t hash; uint32_t index; uint32_t component; float factor; };
+const std::vector<uint64_t>& BsPsConstLogList() {
+  static const std::vector<uint64_t> v = [] {
+    std::vector<uint64_t> r;
+    std::stringstream ss(REXCVAR_GET(ps_const_log));
+    std::string item;
+    while (std::getline(ss, item, ',')) if (!item.empty()) r.push_back(std::strtoull(item.c_str(), nullptr, 16));
+    return r;
+  }();
+  return v;
+}
+const std::vector<BsPsConstMul>& BsPsConstMulList() {
+  static const std::vector<BsPsConstMul> v = [] {
+    std::vector<BsPsConstMul> r;
+    std::stringstream ss(REXCVAR_GET(ps_const_mul));
+    std::string item;
+    while (std::getline(ss, item, ',')) {
+      std::stringstream is(item);
+      std::string h, idx, comp, fac;
+      if (std::getline(is, h, ':') && std::getline(is, idx, ':') && std::getline(is, comp, ':') &&
+          std::getline(is, fac, ':')) {
+        BsPsConstMul m{std::strtoull(h.c_str(), nullptr, 16), uint32_t(std::strtoul(idx.c_str(), nullptr, 10)),
+                       uint32_t(std::strtoul(comp.c_str(), nullptr, 10)) & 3u, float(std::atof(fac.c_str()))};
+        r.push_back(m);
+        REXGPU_INFO("bioshock-recomp: PS {:016X} c{}[{}] *= {}", m.hash, m.index, m.component, m.factor);
+      }
+    }
+    return r;
+  }();
+  return v;
+}
